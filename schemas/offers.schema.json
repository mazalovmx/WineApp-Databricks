{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["offers"],
  "properties": {
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_name",
          "price_mxn",
          "availability",
          "url",
          "confidence"
        ],
        "properties": {
          "product_name": { "type": "string", "minLength": 1 },
          "price_mxn": { "type": "number", "minimum": 0 },
          "discount_text": { "type": ["string", "null"] },
          "volume_ml": { "type": ["integer", "null"], "minimum": 0 },
          "availability": {
            "type": "string",
            "enum": ["in_stock", "unknown", "out_of_stock"]
          },
          "url": { "type": "string", "format": "uri" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
