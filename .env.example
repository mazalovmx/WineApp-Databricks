# Guadalajara Wine Finder - Environment Variables
# Copy to .env in each directory or set in your shell/CI

# === Backend (backend/.env) ===
# Required
DATABASE_URL=postgresql://user:password@localhost:5432/wine_finder
SECRET_KEY=your-secret-key-change-in-production
USER_A_PASSWORD=xK9mN2pQ7sL4vY8w
USER_B_PASSWORD=aB3cD6eF9gH2jK5mN

# Optional
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
STORAGE_MODE=local
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
MAX_PAGES_PER_STORE_PER_RUN=50
MAX_LLM_CALLS_PER_RUN=200

# S3 (optional, for production)
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# === Frontend (NEXT_PUBLIC_*) ===
# Set when running: NEXT_PUBLIC_API_URL=http://localhost:8000

# === Pipeline (uses DATABASE_URL, LLM_*, DATA_DIR from env) ===
# DATA_DIR=./data
# MANUAL_RUN_SECRET=optional-secret-for-trigger-endpoint
