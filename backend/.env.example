# Guadalajara Wine Finder - Backend Environment
# Copy to .env and fill in values (required variables must be set)

DATABASE_URL=postgresql://user:password@localhost:5432/wine_finder
SECRET_KEY=your-secret-key-change-in-production

# User passwords (REQUIRED - change for production)
# User A (user_id: A) and User B (user_id: B)
USER_A_PASSWORD=xK9mN2pQ7sL4vY8w
USER_B_PASSWORD=aB3cD6eF9gH2jK5mN
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Object storage (optional for MVP - use local ./data/ if not set)
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
STORAGE_MODE=local

# LLM Provider (openai, anthropic, etc.)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Run limits (cost control)
MAX_PAGES_PER_STORE_PER_RUN=50
MAX_LLM_CALLS_PER_RUN=200
