# Guadalajara Wine Finder - Backend Environment
# Copy to .env and fill in values

DATABASE_URL=postgresql://user:password@localhost:5432/wine_finder
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Object storage (optional for MVP - use local ./data/ if not set)
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
STORAGE_MODE=local

# LLM Provider (openai, anthropic, etc.)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Run limits (cost control)
MAX_PAGES_PER_STORE_PER_RUN=50
MAX_LLM_CALLS_PER_RUN=200
